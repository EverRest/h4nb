{
  "uid": "h4nb-past-runs",
  "title": "h4nb past runs",
  "description": "Finished runs from h4nb-metrics backfill or from the Prometheus history. specs/002-run-metrics.",
  "tags": [
    "h4nb"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "graphTooltip": 1,
  "time": {
    "from": "now-1y",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "refresh": 2,
        "sort": 1,
        "query": {
          "query": "label_values(h4nb_run_info, run)",
          "refId": "run"
        },
        "definition": "label_values(h4nb_run_info, run)",
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "h4nb"
      ],
      "title": "h4nb dashboards",
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Runs",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Run list",
      "description": "All runs with data in the selected time range. Click a run name to select it and to set the time range to the start and the end of the run. If a run is missing, make the time range larger or load the run with h4nb-metrics backfill.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (run) (last_over_time(h4nb_run_start_timestamp_seconds[$__range])) * 1000",
          "legendFormat": "{{run}}",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (run) (last_over_time(h4nb_run_end_timestamp_seconds[$__range])) * 1000",
          "legendFormat": "{{run}}",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "max by (run) (last_over_time(h4nb_run_state[$__range]))",
          "legendFormat": "{{run}}",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "max by (run) (last_over_time(h4nb_particles[$__range]))",
          "legendFormat": "{{run}}",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "E",
          "expr": "max by (run) (last_over_time(h4nb_energy_max_rel_err[$__range]))",
          "legendFormat": "{{run}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "start",
              "Value #B": "end",
              "Value #C": "state",
              "Value #D": "N",
              "Value #E": "max_rel_err"
            },
            "indexByName": {
              "run": 0,
              "start": 1,
              "end": 2,
              "state": 3,
              "N": 4,
              "max_rel_err": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "start",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "run"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this run",
                    "url": "/d/h4nb-past-runs/h4nb-past-runs?var-run=${__value.raw}&from=${__data.fields[\"start\"]}&to=${__data.fields[\"end\"]}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "start"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "end"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "running",
                        "color": "blue",
                        "index": 0
                      },
                      "1": {
                        "text": "finished",
                        "color": "green",
                        "index": 1
                      },
                      "2": {
                        "text": "stopped early",
                        "color": "red",
                        "index": 2
                      },
                      "3": {
                        "text": "stalled",
                        "color": "orange",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max_rel_err"
            },
            "properties": [
              {
                "id": "unit",
                "value": "sci"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1e-08
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 2,
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "row",
      "title": "Result of the selected run",
      "id": 3,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Final state",
      "description": "Final state of the run. Finished: t reached t_end. Stopped early: h4nb_run stopped with an error before t_end. Stalled: the archive has only .dat.tmp files; the process hung, was killed, or an MPI rank failed.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "last_over_time(h4nb_run_state{run=\"$run\"}[$__range])",
          "legendFormat": "{{run}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "running",
                  "color": "blue",
                  "index": 0
                },
                "1": {
                  "text": "finished",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "stopped early",
                  "color": "red",
                  "index": 2
                },
                "3": {
                  "text": "stalled",
                  "color": "orange",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 4,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Max energy error",
      "description": "Largest relative energy error from t = 0 to the end of the run. Green: below 1e-8. Red: above.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "last_over_time(h4nb_energy_max_rel_err{run=\"$run\"}[$__range])",
          "legendFormat": "{{run}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "sci",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1e-08
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 5,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Final dP_rel and dL_rel",
      "description": "Relative change of the total momentum and of the angular momentum at the last diag time. Both must be near the round-off level (about 1e-14).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "last_over_time(h4nb_momentum_rel_change{run=\"$run\"}[$__range])",
          "legendFormat": "dP_rel",
          "range": false,
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "last_over_time(h4nb_angular_momentum_rel_change{run=\"$run\"}[$__range])",
          "legendFormat": "dL_rel",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "sci",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 6,
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 8,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Mean pair rate",
      "description": "Mean of pairs/s over all diag segments in the time range. Compare it between runs with the same N and GPU.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "avg_over_time(h4nb_pairs_per_second{run=\"$run\"}[$__range])",
          "legendFormat": "{{run}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 7,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 13,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "stat",
      "title": "Wall time",
      "description": "Sum of the wall time of all diag segments. Multiply by the number of GPUs to get GPU hours.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "last_over_time(h4nb_wall_seconds_total{run=\"$run\"}[$__range])",
          "legendFormat": "{{run}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 8,
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 17,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "bargauge",
      "title": "Error per period",
      "description": "Largest relative energy error in each reference period T, from energy_periods.dat. The goal is <= 1e-8 in period 1. A period with complete = 0 was not finished by the run.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "last_over_time(h4nb_period_max_rel_err{run=\"$run\"}[$__range])",
          "legendFormat": "period {{period}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "sci",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1e-08
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left"
      },
      "id": 9,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "row",
      "title": "Curves of the selected run",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "xychart",
      "title": "Energy error against simulation time",
      "description": "Relative energy error at each diag time, plotted against the simulation time. One reference period is T (key period). Steps in the curve at close encounters are normal. A slope that does not stop means drift.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(h4nb_sim_time{run=\"$run\"})",
          "legendFormat": "sim_time",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max(h4nb_energy_rel_err{run=\"$run\"})",
          "legendFormat": "rel_err",
          "range": true,
          "instant": false
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "Time",
            "mode": "outer"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "sci",
          "custom": {
            "show": "lines",
            "lineWidth": 1,
            "pointSize": {
              "fixed": 3
            },
            "scaleDistribution": {
              "type": "log",
              "log": 10
            },
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sim_time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.scaleDistribution",
                "value": {
                  "type": "linear"
                }
              },
              {
                "id": "custom.axisLabel",
                "value": "simulation time"
              }
            ]
          }
        ]
      },
      "options": {
        "seriesMapping": "auto",
        "dims": {
          "frame": 0,
          "x": "sim_time",
          "exclude": [
            "Time"
          ]
        },
        "series": [],
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "id": 11,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Relative energy error",
      "description": "rel_err = abs(E - E0 - W_diss) / D at each diag time. D is abs(E0) (energy_norm=e0) or abs(K0) + abs(U0) (ku). The dashed line is energy_tol. The project goal is rel_err <= 1e-8 over one period. A line that grows steadily means drift: decrease eta or dt_max.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "h4nb_energy_rel_err{run=\"$run\"}",
          "legendFormat": "{{run}}",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max(h4nb_config_value{key=\"energy_tol\",run=\"$run\"})",
          "legendFormat": "energy_tol",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "sci",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "timeseries",
      "title": "Momentum and angular momentum change",
      "description": "dP_rel and dL_rel: change of the total momentum and angular momentum, divided by sum m abs(v) and sum m abs(r x v) of the initial state. Both must stay near the round-off level (about 1e-14). Growth of dP_rel can mean an asymmetric force sum, for example on several GPUs. Growth of dL_rel means an orbit error.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
