    {
      "type": "row",
      "title": "Time steps",
      "id": 15,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Block time steps",
      "description": "Smallest, mean and largest individual time step at each diag time. Steps are dt_max / 2^k. A fast fall of dt_min means a close encounter, and the run becomes slower. dt_min near dt_max / 2^max_level means the step limit is near.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "h4nb_dt_min{run=~\"$run\"}",
          "legendFormat": "dt_min {{run}}",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "h4nb_dt_mean{run=~\"$run\"}",
          "legendFormat": "dt_mean {{run}}",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "h4nb_dt_max{run=~\"$run\"}",
          "legendFormat": "dt_max {{run}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "sci",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
